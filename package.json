{
  "name": "scut-notipay-app",
  "version": "1.0.4",
  "description": "华南理工大学宿舍缴费查询与提醒机器人（桌面管理端）",
  "main": "dist/main/index.js",
  "author": "scut-notipay-app",
  "license": "MPL-2.0",
  "type": "commonjs",
  "scripts": {
    "gen-icon": "node scripts/gen-icon.js",
    "build": "tsc -p tsconfig.json && node scripts/copy-assets.js",
    "postinstall": "electron-rebuild -f -w better-sqlite3 || exit 0",
    "start": "npm run build && electron .",
    "dev": "npm run build && electron . --dev",
    "dist": "npm run build && electron-builder",
    "dist:portable": "npm run build && electron-builder --win portable"
  },
  "dependencies": {
    "better-sqlite3": "^12.4.1",
    "fetch-socks": "^1.3.2",
    "node-napcat-ts": "^0.4.20",
    "undici": "^7.16.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "@types/better-sqlite3": "^7.6.13",
    "@types/node": "^24.9.1",
    "chart.js": "^4.5.1",
    "electron": "^37.2.0",
    "electron-builder": "^26.0.12",
    "typescript": "^5.9.3"
  }
}
